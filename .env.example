# Local environment for the HealthBot Container Sample.
# Copy to `.env` (git-ignored) and fill in the values, then run the app locally:
#
#   npm ci                 # restore node_modules (also fixes core-js quarantine)
#   npm run dev:server     # terminal 1 — Express backend on :8080 (mints Direct Line tokens)
#   npm run dev            # terminal 2 — Vite client on :3000 (proxies /chatBot + /health to :8080)
#
# Then open http://localhost:3000. The client streams through your bot, so you can
# watch the real thinking card (A1 chip + F2 rail) and F1 history in a live conversation.

# Direct Line secret for your Health Bot / Bot Framework channel. REQUIRED for streaming.
# Get it from: Azure portal → your Bot → Channels → Direct Line → Secret keys.
WEBCHAT_SECRET=

# Direct Line host. Leave blank for the public cloud (directline.botframework.com);
# set it only for a regional / sovereign Direct Line endpoint.
DIRECTLINE_ENDPOINT_URI=

# Secret used to sign the app's own session JWT (any sufficiently long random string).
AUTH_JWT_SECRET=

# Optional: port the Express backend listens on (defaults to 8080; the Vite proxy targets 8080).
# PORT=8080

# Optional: free-text region label surfaced on the /health endpoint.
# REGION=local
